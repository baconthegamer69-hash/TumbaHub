            if dragging then
                local mousePos = UserInputService:GetMouseLocation()
                local framePos = SliderTrack.AbsolutePosition
                local frameSize = SliderTrack.AbsoluteSize
                local relativeX = math.clamp((mousePos.X - framePos.X) / frameSize.X, 0, 1)
