                SliderButton.Position = UDim2.new(relativeX, -8, 0.5, -8)

                SliderLabel.Text = GetText("slider_label", translatedText, newValue) -- ИЗМЕНЕНО

                if callback then
                    callback(newValue)
                end
            end
