    local function UpdateChickenESP()
        for _, block in ipairs(CollectionService:GetTagged("HarvestableCrop")) do
            if block.Name == "chicken_egg_block" then
                local stage = block:GetAttribute("CropStage")
                
                -- Find the visual target (stage_4 or block)
                local target = block:FindFirstChild("stage_4") or block
                
                -- Force visibility for stage_4
                if target.Name == "stage_4" then
                    local targetTransparency = (Mega.States.Taliah.Enabled and Mega.States.Taliah.ESP) and 0 or 1
                    if target:IsA("BasePart") then
                        target.Transparency = targetTransparency
                    elseif target:IsA("Model") then
                        for _, v in ipairs(target:GetDescendants()) do
                            if v:IsA("BasePart") then v.Transparency = targetTransparency end
                        end
                    end
                end

                if target ~= block then
                    local oldEsp = block:FindFirstChild("TaliahESP")
                    if oldEsp then oldEsp:Destroy() end
                end
                
                local esp = target:FindFirstChild("TaliahESP")
                
                if Mega.States.Taliah.Enabled and Mega.States.Taliah.ESP and stage == 4 then
                    if not esp then
                        esp = Instance.new("Highlight")
                        esp.Name = "TaliahESP"
                        esp.FillColor = Color3.fromRGB(255, 170, 0) -- Orange
                        esp.OutlineColor = Color3.fromRGB(255, 255, 255)
                        esp.FillTransparency = Mega.States.Taliah.ESPTransparency
                        esp.OutlineTransparency = 0
                        esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        esp.Adornee = target
                        esp.Parent = target
                    else
                        -- Update properties
                        esp.FillTransparency = Mega.States.Taliah.ESPTransparency
                        esp.FillColor = Color3.fromRGB(255, 170, 0)
                        esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        esp.Adornee = target
                        esp.Parent = target
                    end
                else
                    if esp then esp:Destroy() end
                    -- Cleanup potential leftover on block if target switched
                    local leftover = block:FindFirstChild("TaliahESP")
                    if leftover then leftover:Destroy() end
                end
            end
        end
    end

