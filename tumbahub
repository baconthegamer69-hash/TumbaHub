    CreateToggleWithSettings(PlayerFrame, "toggle_spider", Mega.States.Player.Spider, function(state)
        Mega.States.Player.Spider = state
        if state then
            local rayCheck = RaycastParams.new()
            rayCheck.FilterType = Enum.RaycastFilterType.Blacklist
            local Active = nil
            
            Mega.Objects.Connections.Spider = RunService.Heartbeat:Connect(function(dt)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    local root = LocalPlayer.Character.HumanoidRootPart
                    local hum = LocalPlayer.Character.Humanoid
                    
                    rayCheck.FilterDescendantsInstances = {LocalPlayer.Character, Workspace.CurrentCamera}
                    
                    local vec = hum.MoveDirection * 2.5
                    local ray = Workspace:Raycast(root.Position - Vector3.new(0, 2, 0), vec, rayCheck)
                    
                    if Active and not ray then
