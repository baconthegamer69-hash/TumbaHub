    CreateToggleWithSettings(PlayerFrame, "toggle_fly", Mega.States.Player.Fly, function(state)
        Mega.States.Player.Fly = state
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        
        if state and root then
            Mega.Objects.Connections.Fly = RunService.RenderStepped:Connect(function(dt)
                if not Mega.States.Player.Fly then return end
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if not hrp or not hum then return end
                
                local cam = Workspace.CurrentCamera
                local speed = Mega.States.Player.FlySpeed
                local mode = Mega.States.Player.FlyMode
                
                local moveDir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
                
                moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                if moveDir.X ~= moveDir.X then moveDir = Vector3.zero end
                
                local vert = 0
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert = 1 end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vert = -1 end
                
                if mode == "Velocity" then
                    local bv = hrp:FindFirstChild("VapeFlyVelocity") or Instance.new("BodyVelocity")
                    bv.Name = "VapeFlyVelocity"
                    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bv.Parent = hrp
                    
                    local bg = hrp:FindFirstChild("VapeFlyGyro") or Instance.new("BodyGyro")
                    bg.Name = "VapeFlyGyro"
                    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                    bg.P = 10000
                    bg.D = 100
                    bg.Parent = hrp
                    
                    local finalVel = (moveDir * speed) + Vector3.new(0, vert * speed, 0)
                    bv.Velocity = finalVel
                    bg.CFrame = cam.CFrame
                    hrp.AssemblyLinearVelocity = finalVel
                    
                elseif mode == "CFrame" then
                    if hrp:FindFirstChild("VapeFlyVelocity") then hrp.VapeFlyVelocity:Destroy() end
                    if hrp:FindFirstChild("VapeFlyGyro") then hrp.VapeFlyGyro:Destroy() end
                    
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    local newPos = hrp.CFrame.Position + (moveDir * speed * dt) + (Vector3.new(0, vert * speed * dt, 0))
                    hrp.CFrame = CFrame.new(newPos, newPos + cam.CFrame.LookVector)
                end
            end)
        else
            if Mega.Objects.Connections.Fly then
                Mega.Objects.Connections.Fly:Disconnect()
                Mega.Objects.Connections.Fly = nil
            end
            if root then
                for _, v in pairs(root:GetChildren()) do
                    if v.Name == "VapeFlyVelocity" or v.Name == "VapeFlyGyro" then
                        v:Destroy()
                    end
                end
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end, flySettings)

